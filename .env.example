# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (mismo proyecto que ensilperu.com). Copiar a .env.local con los valores reales.
# Solo la clave publica (anon/publishable). NUNCA la service_role.
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_CLAVE_PUBLICA"

# Dirección pública del sistema para los enlaces de los correos (invitación, contraseña olvidada). En Vercel: la dirección del despliegue,
# p. ej. https://ensil-sistema.vercel.app (sin barra final). Si no se define, se usa la de la pestaña (en local, localhost).
# Debe estar también en Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_APP_URL="https://ensil-sistema.vercel.app"
